{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprasa.org/internal/schemas/things-to-do-event-publication-packet-v1.json",
  "title": "A PRASA Things-to-Do approved event publication packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "event", "localization", "media", "governance", "control"],
  "properties": {
    "contract_version": { "const": 1 },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "provider", "summary", "category", "location", "source_url", "source_type", "checked_at", "publication_state", "media_policy", "media_manifest_title", "detail_page", "display", "detail", "seo"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "const": "dated-event" },
        "title": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "locality": { "type": "string" },
            "street": { "type": "string" }
          }
        },
        "source_url": { "type": ["string", "null"], "minLength": 1 },
        "source_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "kind", "evidence_ref"],
          "properties": {
            "version": { "const": 1 },
            "kind": { "const": "restricted-evidence" },
            "evidence_ref": { "enum": ["kutumbaia-edicao-03-2026", "manxi-liliane-reis-exhibition-2026"] }
          }
        },
        "source_type": { "type": "string", "minLength": 1 },
        "start_date": { "type": ["string", "null"] },
        "start_datetime": { "type": ["string", "null"] },
        "end_date": { "type": ["string", "null"] },
        "end_datetime": { "type": ["string", "null"] },
        "end_month": { "type": ["string", "null"] },
        "end_precision": { "type": "string" },
        "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "publication_state": { "enum": ["draft", "published", "expired", "withdrawn"] },
        "media_policy": { "enum": ["required", "fallback_allowed"] },
        "media_manifest_title": { "type": "string", "minLength": 1 },
        "detail_page": { "type": "string", "pattern": "^things-to-do/[a-z0-9]+(?:-[a-z0-9]+)*/$" },
        "free_admission": { "type": ["boolean", "null"] },
        "currentness_note": { "type": "string" },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string" },
            "meta": { "type": "string" },
            "checked": { "type": "string" }
          }
        },
        "media": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "asset": { "type": "string" },
            "alt": { "type": "string" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "card_action": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "label": { "type": "string" },
            "url": { "type": "string", "minLength": 1, "pattern": "^[hH][tT][tT][pP][sS]?://" }
          }
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "facts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label"],
                "properties": {
                  "label": { "type": "string" },
                  "value": { "type": "string" },
                  "value_html": { "type": "string" }
                },
                "oneOf": [
                  { "required": ["value"] },
                  { "required": ["value_html"] }
                ]
              }
            },
            "body": { "type": "string" },
            "good_to_know": { "type": ["string", "null"] },
            "checked": { "type": "string" },
            "action_label": { "type": ["string", "null"] }
          }
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "title": { "type": "string" },
            "schema_type": { "type": "string" }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "id": { "not": { "enum": ["kutumbaia-edicao-03-2026", "manxi-liliane-reis-exhibition-2026"] } },
            "source_url": { "type": "string", "pattern": "^[hH][tT][tT][pP][sS]?://" }
          },
          "not": { "required": ["source_reference"] }
        },
        {
          "properties": {
            "id": { "const": "kutumbaia-edicao-03-2026" },
            "source_url": { "type": "null" },
            "source_reference": { "properties": { "evidence_ref": { "const": "kutumbaia-edicao-03-2026" } } },
            "card_action": { "type": "null" },
            "detail": { "properties": { "action_label": { "type": "null" } } }
          },
          "required": ["source_reference"]
        },
        {
          "properties": {
            "id": { "const": "manxi-liliane-reis-exhibition-2026" },
            "source_url": { "type": "null" },
            "source_reference": { "properties": { "evidence_ref": { "const": "manxi-liliane-reis-exhibition-2026" } } },
            "card_action": { "type": "null" },
            "detail": { "properties": { "action_label": { "type": "null" } } }
          },
          "required": ["source_reference"]
        }
      ]
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pt_status", "new_strings_required", "pt_values"],
      "properties": {
        "pt_status": { "enum": ["approved", "approval_required", "not_required"] },
        "new_strings_required": { "type": "boolean" },
        "pt_values": { "type": "object" },
        "approved_package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_id", "source_revision", "project_09_status", "rows"],
          "properties": {
            "package_id": { "type": "string", "minLength": 1 },
            "source_revision": { "type": "string", "minLength": 1 },
            "project_09_status": { "const": "approved" },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "source_revision", "source_en", "pt", "scope_status", "identity_policy", "context_notes", "record_id", "linguistic_notes", "translation_status"],
                "properties": {
                  "key": { "type": "string" },
                  "source_revision": { "type": "string" },
                  "source_en": { "type": "string" },
                  "pt": { "type": "string" },
                  "scope_status": { "type": "string" },
                  "identity_policy": { "type": "string" },
                  "context_notes": { "type": "string" },
                  "record_id": { "type": "string" },
                  "linguistic_notes": { "type": "string" },
                  "translation_status": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights_status", "alt_status", "source_url", "local_asset"],
      "properties": {
        "rights_status": { "enum": ["approved", "review_required", "not_required"] },
        "alt_status": { "enum": ["approved", "review_required", "not_required"] },
        "source_url": { "type": ["string", "null"] },
        "local_asset": {
          "type": ["string", "null"],
          "pattern": "^assets/events/[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:avif|jpe?g|png|webp)$"
        },
        "supplied_asset": { "type": ["string", "null"] },
        "asset_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "approved_manifest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": { "type": "string" },
            "title": { "type": "string" },
            "provider": { "type": "string" },
            "source_url": { "type": ["string", "null"], "pattern": "^[hH][tT][tT][pP][sS]?://" },
            "media_type": { "type": "string" },
            "media_state": { "type": "string" },
            "media_source": { "type": ["string", "null"] },
            "media_asset": { "type": ["string", "null"] },
            "fallback_category": { "type": "string" },
            "fallback_reason": { "type": ["string", "null"] },
            "media_provenance": { "type": "string" },
            "media_asset_source_url": { "type": ["string", "null"], "pattern": "^[hH][tT][tT][pP][sS]?://" },
            "media_checked_date": { "type": ["string", "null"] },
            "media_alt": { "type": ["string", "null"] },
            "media_width": { "type": ["number", "null"] },
            "media_height": { "type": ["number", "null"] }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_authorized", "project03_status", "project09_status", "media_status"],
      "properties": {
        "publication_authorized": { "type": "boolean" },
        "project03_status": { "enum": ["approved", "approval_required"] },
        "project09_status": { "enum": ["approved", "approval_required", "not_required"] },
        "media_status": { "enum": ["approved", "review_required", "not_required"] }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run", "as_of", "allow_branch", "allow_commit", "allow_pr", "merge_allowed"],
      "properties": {
        "dry_run": { "type": "boolean" },
        "real_write": { "type": "boolean", "default": false },
        "expected_main_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "allow_branch": { "type": "boolean" },
        "allow_commit": { "type": "boolean" },
        "allow_pr": { "type": "boolean" },
        "merge_allowed": { "const": false }
      },
      "oneOf": [
        {
          "properties": {
            "dry_run": { "const": true },
            "real_write": { "enum": [false] }
          }
        },
        {
          "required": ["real_write", "expected_main_sha"],
          "properties": {
            "dry_run": { "const": false },
            "real_write": { "const": true },
            "allow_branch": { "const": true },
            "allow_commit": { "const": true },
            "allow_pr": { "const": true }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprasa.org/schemas/control-plane/task-result.schema.json",
  "title": "A PRASA Control-Plane Task Result",
  "description": "Provider-neutral, content-addressed record of an exception or review outcome that stops autonomous progression. This schema fixes the shape only. The fixed mapping from result_type to status/owner/resume_point/reviewer is a semantic invariant enforced by scripts/lib/control-plane-result.mjs and scripts/validate-control-plane-result.mjs, not by this document, because the repository's schema validator does not implement if/then/else or allOf. Persisting one of these records never grants publication, merge, or deploy authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "result_type",
    "status",
    "task_ref",
    "repository",
    "owner",
    "reason",
    "required_input",
    "resume_point",
    "evidence_digest",
    "reviewer",
    "upstream_refs",
    "grants_publication_authority",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "result_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 content digest of this record with result_id itself removed. Two records with identical content always produce the same id."
    },
    "result_type": {
      "enum": [
        "NEEDS_EVIDENCE_VERIFICATION",
        "NEEDS_PROJECT_03_DECISION",
        "TECHNICAL_VALIDATION_FAILED",
        "REVIEW_PASSED",
        "REVIEW_FAILED"
      ]
    },
    "status": {
      "enum": ["HOLD", "ESCALATED", "BLOCKED", "REVIEWED"],
      "description": "Drawn from the committed task-envelope status vocabulary. The exact value required for each result_type is a semantic invariant, not expressed here."
    },
    "task_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "candidate_id"],
      "properties": {
        "task_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{5,127}$" }
          ]
        },
        "candidate_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "ref"],
      "description": "The exact repository state this result was produced against. A result whose repository.sha no longer matches the candidate's current head SHA is stale; scripts/validate-control-plane-result.mjs --candidate-sha=<sha> enforces this, most strictly for REVIEW_PASSED and REVIEW_FAILED.",
      "properties": {
        "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "ref": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        }
      }
    },
    "owner": {
      "enum": ["EVIDENCE_VERIFIER", "INDEPENDENT_REVIEWER", "PROJECT_03", "PROJECT_04"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "required_input": { "type": "string", "minLength": 1 },
    "resume_point": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["next_role", "next_status"],
          "properties": {
            "next_role": {
              "enum": [
                "DISCOVERY_WORKER", "EVIDENCE_VERIFIER", "POLICY_ADJUDICATOR",
                "LOCALIZATION_WORKER", "MEDIA_VALIDATOR", "PUBLICATION_WRITER",
                "INDEPENDENT_REVIEWER", "PRODUCTION_QA", "LIFECYCLE_MONITOR",
                "HUMAN_ESCALATION"
              ]
            },
            "next_status": {
              "enum": [
                "DISCOVERED", "NORMALIZED", "EVIDENCE_CHECKED", "ADJUDICATED",
                "SELECTED", "HOLD", "REJECTED", "LOCALIZED", "MEDIA_VALIDATED",
                "PUBLICATION_READY", "IMPLEMENTED", "REVIEWED", "DEPLOYMENT_READY",
                "PUBLISHED", "PRODUCTION_VERIFIED", "MONITORED", "EXPIRED",
                "WITHDRAWN", "SUPERSEDED", "ESCALATED", "BLOCKED"
              ]
            }
          }
        }
      ]
    },
    "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewer": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "identity"],
          "properties": {
            "role": { "enum": ["INDEPENDENT_REVIEWER", "HUMAN_ESCALATION"] },
            "identity": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "upstream_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {
            "enum": ["FILE", "URL", "GITHUB_SHA", "PR", "DRIVE_ITEM", "TASK_RESULT", "AUDIT_RECORD"]
          },
          "ref": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "grants_publication_authority": { "const": false },
    "created_at": { "type": "string", "format": "date-time" }
  }
}

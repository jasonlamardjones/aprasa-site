{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprasa.org/schemas/control-plane/adjudication-policy.schema.json",
  "title": "A PRASA Adjudication Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "domain", "authority", "default_disposition", "rules", "escalation_classes"],
  "properties": {
    "policy_id": { "type": "string", "pattern": "^[A-Z0-9._-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "domain": { "type": "string" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "technical_interpreter"],
      "properties": {
        "owner": { "type": "string" },
        "technical_interpreter": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "default_disposition": { "enum": ["SELECT", "HOLD", "REJECT"] },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "status", "description", "when", "result", "human_review"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[A-Z0-9._-]+$" },
          "status": { "enum": ["ACTIVE", "DEFERRED"] },
          "description": { "type": "string", "minLength": 1 },
          "when": { "type": "object" },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disposition"],
            "properties": {
              "disposition": { "enum": ["SELECT", "HOLD", "REJECT", "NO_CHANGE"] },
              "publication_blocked": { "type": "boolean" },
              "field_actions": { "type": "object" },
              "reason_code": { "type": "string" }
            }
          },
          "human_review": { "type": "boolean" },
          "authority_note": { "type": "string" }
        }
      }
    },
    "escalation_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "NOVEL_POLICY_QUESTION",
          "HIGH_QUALITY_SOURCE_CONFLICT",
          "COMMERCIAL_POLICY_UNRESOLVED",
          "MEDIA_RIGHTS_UNRESOLVED",
          "LEGAL_OR_REPUTATIONAL_RISK",
          "AUTHORITY_CONFLICT",
          "AUTOMATION_CONFIDENCE_BELOW_THRESHOLD"
        ]
      }
    }
  }
}

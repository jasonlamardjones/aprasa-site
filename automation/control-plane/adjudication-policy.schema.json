{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprasa.org/schemas/control-plane/adjudication-policy.schema.json",
  "title": "A PRASA Adjudication Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "domain", "authority", "default_disposition", "composition", "rules", "escalation_classes"],
  "properties": {
    "policy_id": { "type": "string", "pattern": "^[A-Z0-9._-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "domain": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "technical_interpreter", "approval_reference"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "technical_interpreter": { "type": "string", "minLength": 1 },
        "approval_reference": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "default_disposition": { "enum": ["SELECT", "HOLD", "REJECT"] },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_semantics",
        "unknown_material_input",
        "deferred_match",
        "blocking_is_monotonic",
        "no_change_is_non_clearing",
        "disposition_precedence",
        "human_review_semantics"
      ],
      "properties": {
        "predicate_semantics": { "const": "ALL_DECLARED_PREDICATES_MUST_BE_PRESENT_AND_EQUAL" },
        "unknown_material_input": { "const": "HOLD" },
        "deferred_match": { "const": "HOLD_AND_BLOCK" },
        "blocking_is_monotonic": { "const": true },
        "no_change_is_non_clearing": { "const": true },
        "disposition_precedence": {
          "type": "array",
          "const": ["HOLD", "REJECT", "SELECT", "NO_CHANGE"]
        },
        "human_review_semantics": {
          "const": "STOP_AUTONOMOUS_PROGRESSION_AND_ROUTE_TO_DECLARED_AUTHORITY"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "status", "description", "when", "result", "human_review", "authority_refs"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[A-Z0-9._-]+$" },
          "status": { "enum": ["ACTIVE", "DEFERRED"] },
          "description": { "type": "string", "minLength": 1 },
          "when": { "type": "object", "minProperties": 1 },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disposition", "publication_blocked", "reason_code"],
            "properties": {
              "disposition": { "enum": ["SELECT", "HOLD", "REJECT", "NO_CHANGE"] },
              "publication_blocked": { "type": "boolean" },
              "field_actions": { "type": "object" },
              "reason_code": { "type": "string", "minLength": 1 }
            }
          },
          "human_review": { "type": "boolean" },
          "authority_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "authority_note": { "type": "string" }
        }
      }
    },
    "escalation_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "NOVEL_POLICY_QUESTION",
          "HIGH_QUALITY_SOURCE_CONFLICT",
          "COMMERCIAL_POLICY_UNRESOLVED",
          "MEDIA_RIGHTS_UNRESOLVED",
          "LEGAL_OR_REPUTATIONAL_RISK",
          "AUTHORITY_CONFLICT",
          "AUTOMATION_CONFIDENCE_BELOW_THRESHOLD"
        ]
      }
    }
  }
}
